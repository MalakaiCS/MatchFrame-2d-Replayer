# Matchframe2D Replayer: sample environment. No secrets here; copy to web/.env.local and set real values.

# --- shared (web + worker)
DATABASE_URL=postgres://mf:mf@localhost:5432/matchframe
STORAGE_DRIVER=fs                     # fs (local dev) | s3 (production)
STORAGE_FS_ROOT=/absolute/path/to/MatchFrame-2d-Replayer/.data/objects
S3_BUCKET=
S3_ENDPOINT=                          # S3-compatible endpoint used by the server (private network if available)
S3_PUBLIC_ENDPOINT=                   # endpoint browsers PUT uploads to (defaults to S3_ENDPOINT)
S3_REGION=auto
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: set as secrets in the platform, never committed.
MAX_DEMO_BYTES=1073741824             # 1 GiB per upload (.dem or compressed; BO3 archives are ~300-600 MB)
MAX_EXTRACTED_DEMO_BYTES=1610612736    # 1.5 GiB cap on a demo extracted from .bz2/.gz/.zip/.rar
MF_ALLOW_SYNTHETIC=0                  # 1 only in dev/test: accept MFSYNTH1 fixture uploads

# --- web
APP_ORIGIN=http://localhost:3000      # production: https://2d.matchframe.tv
# TRUSTED_ORIGINS=                     # extra comma-separated origins allowed to sign in (Railway domain is added automatically)
AUTH_SECRET=                          # >= 32 random characters (openssl rand -base64 48)
ALLOW_SIGNUP=1                        # 0 disables self-service sign-up
# AUTH_RATE_LIMIT=0                   # test environments only: disables Better Auth rate limiting
UPLOAD_SLOT_SECONDS=900
PENDING_SOURCE_TTL_S=259200           # failed/pending sources expire after 3 days
MAX_AUDIO_BYTES=314572800
STREAM_URL_SECONDS=600

# --- worker
WORKER_TMP_DIR=/tmp/matchframe-worker
WORKER_MAX_TMP_BYTES=4294967296
WORKER_PARSE_MEMORY_BYTES=6442450944     # virtual-memory cap for the parser subprocess; 0 = rely on the container limit
WORKER_PARSE_TIMEOUT_S=900
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_BACKOFF_BASE_S=30
WORKER_BACKOFF_MAX_S=900
MAINTENANCE_EVERY_S=300
ABANDONED_REVISION_AGE_S=3600
KEEP_SOURCE_AFTER_PARSE=0
SAMPLE_EVERY_TICKS=4                  # 64-tick demos -> 16 Hz samples
WORKER_RECORDED_RESERVE=0             # 1 = show recorded reserve ammo like the reference (needs ~6.6-10 GiB worker RAM per demo)
# MAP_REGISTRY_PATH=/app/maps.json    # set in the worker image

# ---- Plans (personal / team). Nothing is enforced unless BILLING_ENABLED=1.
BILLING_ENABLED=0
# Stripe: secret key, webhook signing secret, and the two recurring prices (Products -> Prices in Stripe).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_TEAM=
# Optional cap on members of a team that has a team plan (0 = no cap).
TEAM_PLAN_MAX_MEMBERS=0
# Optional yearly prices (shows a Monthly / Yearly switch on the plans page).
STRIPE_PRICE_PERSONAL_YEARLY=
STRIPE_PRICE_TEAM_YEARLY=
# Charge the team plan per member (Stripe quantity follows the roster, prorated), with a minimum.
TEAM_PLAN_PER_SEAT=0
TEAM_PLAN_MIN_SEATS=1
